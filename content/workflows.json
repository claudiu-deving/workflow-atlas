{
  "sheets": [
    {
      "id": "authoring-loop",
      "code": "WA-00",
      "name": "Authoring loop",
      "title": "Show, don't tell — the authoring loop",
      "sub": "How a described algorithm becomes a moving picture you can watch, and how your response feeds back to the assistant.",
      "stations": [
        {
          "title": "Assistant proposes an algorithm",
          "sub": "mid-conversation, instead of prose",
          "status": "done",
          "detail": {
            "in": [
              "A question you can't easily picture"
            ],
            "out": [
              "Intent to build a storyboard"
            ],
            "note": "The whole point: hand you something to look at rather than a paragraph to decode."
          }
        },
        {
          "title": "Author over MCP",
          "sub": "save_algorithm / save_workflows",
          "status": "done",
          "detail": {
            "in": [
              "save_algorithm { spec }",
              "save_workflows { sheets }"
            ],
            "out": [
              "Validated JSON"
            ],
            "note": "The spec is validated: id is a slug, kind is array|calc, and it carries either explicit steps[] or a builtin generator + data.",
            "open": [
              "Author explicit frames, or lean on a built-in generator?"
            ]
          }
        },
        {
          "title": "Persist + re-index",
          "sub": "server writes the files",
          "status": "done",
          "detail": {
            "in": [
              "Validated spec"
            ],
            "out": [
              "content/algorithms/<id>.json",
              "content/index.json rewritten"
            ],
            "note": "The discovery manifest is rebuilt on every save/delete, so the app finds the storyboard with no registration step."
          }
        },
        {
          "title": "Surface the change",
          "sub": "the server already knows if a tab is live",
          "status": "done",
          "fan": {
            "tracks": [
              {
                "title": "Tab open → live-reload",
                "status": "done",
                "detail": {
                  "note": "fs.watch fires → SSE broadcast → the open tab runs location.reload()."
                }
              },
              {
                "title": "No tab → open the browser",
                "status": "done",
                "detail": {
                  "note": "openInBrowser to the relevant view — gated by connected SSE clients, a 4s debounce, and ATLAS_NO_OPEN."
                }
              }
            ]
          },
          "detail": {
            "note": "Reviews (content/reviews/) are excluded from the watcher, so the app's own autosaves never trigger a reload."
          }
        },
        {
          "title": "Browser builds the storyboard",
          "sub": "discover → load → render",
          "status": "done",
          "fan": {
            "tracks": [
              {
                "title": "Binary search",
                "status": "done",
                "algorithm": "binary-search"
              },
              {
                "title": "Bubble sort",
                "status": "done",
                "algorithm": "bubble-sort"
              },
              {
                "title": "Euclid's GCD",
                "status": "done",
                "algorithm": "euclid-gcd"
              }
            ]
          },
          "detail": {
            "in": [
              "content/index.json"
            ],
            "out": [
              "Traces",
              "The rendered stage"
            ],
            "note": "fetch manifest → each spec → builtin generator or explicit steps → compute(params) → frames → array/worksheet stage."
          }
        },
        {
          "title": "You watch, then respond",
          "sub": "tune, comment, decide",
          "status": "done",
          "loop": {
            "to": 1,
            "label": "comment / decision → revise"
          },
          "detail": {
            "in": [
              "The animation"
            ],
            "out": [
              "Tuned params",
              "Per-step comments",
              "Recorded decisions"
            ],
            "note": "Edits autosave to content/reviews/<id>.json. The assistant reads them back over MCP (get_review, list_open_questions) and revises — closing the loop."
          }
        }
      ]
    },
    {
      "id": "boot-serve",
      "code": "WA-01",
      "name": "Boot & serve",
      "title": "One zero-dependency process",
      "sub": "How the server starts, claims a port, watches the project, and serves three surfaces at once.",
      "stations": [
        {
          "title": "Start the server",
          "sub": "npm start, or Claude Code spawns it over stdio",
          "status": "done",
          "detail": {
            "out": [
              "One Node process — no dependencies"
            ],
            "note": "The same process serves the UI and speaks MCP, so the app and the assistant share one source of truth."
          }
        },
        {
          "title": "Claim a port",
          "sub": "adapt to whatever holds it",
          "status": "done",
          "fan": {
            "tracks": [
              {
                "title": "Free → serve the UI here",
                "status": "done"
              },
              {
                "title": "Another atlas → reuse it, run as a stdio worker",
                "status": "done"
              },
              {
                "title": "Something else → step to the next free port",
                "status": "done"
              }
            ]
          },
          "detail": {
            "note": "On EADDRINUSE it probes /api/health to tell which case it is, then reuses, climbs, or serves.",
            "open": [
              "Cap the port search (currently 12), or keep climbing?"
            ]
          }
        },
        {
          "title": "Watch the project",
          "sub": "for live reload",
          "status": "done",
          "detail": {
            "in": [
              "fs.watch(root, recursive)"
            ],
            "out": [
              "A live-reload SSE stream"
            ],
            "note": "content/reviews/ is excluded so review autosaves don't reload the page under you."
          }
        },
        {
          "title": "Serve three things at once",
          "sub": "from one handler",
          "status": "done",
          "fan": {
            "tracks": [
              {
                "title": "Static app",
                "status": "done"
              },
              {
                "title": "REST review autosave",
                "status": "done"
              },
              {
                "title": "MCP — stdio + /mcp",
                "status": "done"
              }
            ]
          }
        }
      ]
    }
  ]
}
